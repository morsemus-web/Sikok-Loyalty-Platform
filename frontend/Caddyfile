}

# ---- Production: sikok.in (auto-HTTPS via Let's Encrypt) ----
sikok.in, www.sikok.in {
    encode gzip zstd

    # `handle` blocks are mutually exclusive — first match wins.
    # Without them, Caddy's default directive order runs try_files before
    # reverse_proxy and rewrites /api/* to /index.html.

    handle /socket.io/* {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        format console
    }
}

# ---- HTTP fallback on bare IP (no TLS) ----
:80 {
    encode gzip zstd

    handle /socket.io/* {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
