    email morsemus@gmail.com
}

# Auto-HTTPS via Let's Encrypt for both apex and www.
sikok.in, www.sikok.in {
    encode gzip zstd

    handle /socket.io/* {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    # The site root explicitly serves index.html — without this, the
    # `not file` matcher below would treat `/` as missing and redirect.
    handle / {
        root * /usr/share/caddy
        rewrite * /index.html
        file_server
    }

    # Everything else: real assets pass through, unknown paths 302 to / with
    # the query string preserved (so QR scans like /xyz?shop=1 still land).
    handle {
        root * /usr/share/caddy

        @missing {
            not file
        }
        redir @missing /?{query} 302

        file_server
    }

    log {
        output stdout
        format console
    }
}
