DATABASE_URL=postgresql+asyncpg://sikok:sikok@localhost:5432/sikok
JWT_SECRET=change-me-to-a-long-random-string
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Tech operator chat id — gets the full activity feed and errors.
# The shop owner chat id (interactive approvals) lives on the shops table.
TECH_TELEGRAM_CHAT_ID=
DEFAULT_SHOP_ID=1
DEBOUNCE_SECONDS=60
DISCOUNT_PER_ITEM=100
STAMPS_TO_REWARD=4
# Indian Standard Time — used for once-per-day stamp limit and user-facing dates.
TIMEZONE_NAME=Asia/Kolkata
IST_OFFSET_MINUTES=330
